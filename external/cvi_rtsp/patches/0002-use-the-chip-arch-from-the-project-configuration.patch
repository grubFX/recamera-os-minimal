From: recamera-os <noreply@recamera.local>
Subject: [PATCH] build: use the chip arch and the middleware include paths

Makefile.inc reads CHIP_ARCH from the project configuration and then
overwrites it with a hard-coded CV186X. The camera is a CV181X (sg2002),
so the build looks for headers in include/isp/cv186x, which does not
exist, and the RTSP service does not compile.

The middleware also installs headers that the service expects elsewhere:
sensor_list.h in component/isp/common, and cvi_type.h in include/linux
although the service includes the latter without the linux/ prefix.

Generated with diff -u against cvi_rtsp as vendored in this repo.


--- a/Makefile.inc	2026-11-12 18:37:35.526234343 +0000
+++ b/Makefile.inc	2026-11-12 18:37:35.539035811 +0000
@@ -4,7 +4,10 @@
 CHIP_ARCH ?= CV182X
 endif
 
-CHIP_ARCH := CV186X
+# The upstream file hard-codes CHIP_ARCH := CV186X here, which overrides the
+# value that was just read from the project configuration. The camera is a
+# CV181X (sg2002), and the hard-coded value makes the build look for headers
+# in include/isp/cv186x, which does not exist.
 
 CHIP_ARCH_LOWERCASE := $(shell echo $(CHIP_ARCH) | tr A-Z a-z)
 SDK_VER ?= 64bit
@@ -59,7 +62,14 @@
     MW_ISP_LIB ?= -L$(MW_DIR)/lib -lisp -lisp_algo -lae -laf -lawb
 endif
 
-    MW_INC ?= -I$(MW_DIR)/include -I$(MW_DIR)/sample/common -I$(MW_DIR)/include/isp/$(CHIP_ARCH_LOWERCASE) -I$(CVI_TRACER_INC) $(CVI_TARGET_PACKAGES_INCLUDE)
+    # The ISP component installs sensor_list.h into component/isp/common, and
+    # sample/common/sample_comm.h includes it by name. The service headers
+    # include <cvi_type.h> without the linux/ prefix, while the header itself
+    # lives in include/linux. Without these two directories on the include
+    # path the service build stops with
+    # "fatal error: sensor_list.h: No such file or directory" and
+    # "fatal error: cvi_type.h: No such file or directory".
+    MW_INC ?= -I$(MW_DIR)/include -I$(MW_DIR)/include/linux -I$(MW_DIR)/sample/common -I$(MW_DIR)/component/isp/common -I$(MW_DIR)/include/isp/$(CHIP_ARCH_LOWERCASE) -I$(CVI_TRACER_INC) $(CVI_TARGET_PACKAGES_INCLUDE)
     MW_LIB ?= -L$(MW_DIR)/lib -lsample -lcvi_bin -lcvi_bin_isp -lvpu -lm -lsys -lvenc -lvdec -lsns_full -lcvi_jpeg -lcvi_vcodec -lz -lini $(MW_ISP_LIB) -L$(MW_DIR)/lib/3rd $(CVI_TARGET_PACKAGES_LIBDIR) $(CVI_TRACER_LIB)
 endif
 
