From: recamera-os <noreply@recamera.local>
Subject: [PATCH] service: match the printf format to the CVI_U64 type

CVI_U64 is "unsigned long long int", but PRIu64 expands to "lu" on
LP64. The compiler rejects the mismatch, and the service is built with
-Werror=format, so the build stops there.

Generated with diff -u against cvi_rtsp as vendored in this repo.


--- a/service/api.cpp	2026-11-12 18:42:04.499167249 +0000
+++ b/service/api.cpp	2026-11-12 18:42:04.508712501 +0000
@@ -331,8 +331,12 @@
 
             if (getenv("VPSS_DEBUG")) {
                 uint64_t vpss_pts_diff = (stVideoFrame.stVFrame.u64PTS - ent->vpssPrePTS);
-                printf("VPSS PTS: %" PRIu64 ", prePTS: %" PRIu64 ", Diff: %" PRIu64 "\n",
-                stVideoFrame.stVFrame.u64PTS, ent->vpssPrePTS, vpss_pts_diff);
+                // CVI_U64 is "unsigned long long", while PRIu64 expands to "lu"
+                // on LP64. The format has to match the type, otherwise the
+                // build fails with -Werror=format.
+                printf("VPSS PTS: %llu, prePTS: %llu, Diff: %llu\n",
+                (unsigned long long)stVideoFrame.stVFrame.u64PTS,
+                (unsigned long long)ent->vpssPrePTS, (unsigned long long)vpss_pts_diff);
                 ent->vpssPrePTS = stVideoFrame.stVFrame.u64PTS;
             }
 
@@ -428,7 +432,12 @@
         if (getenv("VENC_DEBUG")) {
             uint64_t venc_pts_diff = (stStream.pstPack[0].u64PTS - ent->vencPrePTS);
             ent->vencPrePTS = stStream.pstPack[0].u64PTS;
-            printf("VENC pts: %" PRIu64 ", prePTS: %" PRIu64 ", duration: %" PRIu64 "\n", stStream.pstPack[0].u64PTS, ent->vencPrePTS, venc_pts_diff);
+            // CVI_U64 is "unsigned long long", while PRIu64 expands to "lu"
+            // on LP64. The format has to match the type, otherwise the build
+            // fails with -Werror=format.
+            printf("VENC pts: %llu, prePTS: %llu, duration: %llu\n",
+            (unsigned long long)stStream.pstPack[0].u64PTS,
+            (unsigned long long)ent->vencPrePTS, (unsigned long long)venc_pts_diff);
         }
 
         CVI_MEDIA_ListPushBack(VencChn, &stStream);
