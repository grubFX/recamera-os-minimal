#!/bin/sh
#
# acme-provider: choose the DNS provider for the ACME DNS-01 challenge.
#
# The camera gets its certificate from an ACME server. The DNS-01 challenge
# is the one that works without a port open on the router: the camera writes
# a TXT record for the domain through the DNS provider API, and the ACME
# server checks it there.
#
# The script stores the provider code and its credentials in
# /etc/acme.sh/provider.conf, and acme.sh reads them from there.
#
# Usage:
#   acme-provider list          show the providers and the current choice
#   acme-provider set <code>    choose a provider
#   acme-provider creds <code>  set the credentials of a provider
#   acme-provider show          show the stored configuration
#

CONF=${CONF:-/etc/acme.sh/provider.conf}

PROVIDERS="
1984hosting:1984Hosting
abion:Abion
acmedns:Acmedns
acmeproxy:Acmeproxy
active24:Active24
