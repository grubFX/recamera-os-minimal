Subject: [PATCH] include <sys/pidfd.h> when the system has it

The host libc (glibc >= 2.36) provides <sys/pidfd.h>, which declares
pidfd_open() and pidfd_send_signal().  util-linux 2.36.2 only uses its own
static inline fallback when HAVE_PIDFD_OPEN / HAVE_PIDFD_SEND_SIGNAL are
not defined, so on such a host the declarations from <sys/pidfd.h> conflict
with the fallback and misc-utils/kill.c fails to build with

    error: implicit declaration of function 'pidfd_open'

Detect the header with AC_CHECK_HEADERS() and include it from
include/pidfd-utils.h when it is available.  The static inline fallbacks
are still used when the system does not provide the header.

--- a/configure.ac
+++ b/configure.ac
@@ -318,6 +318,8 @@
 	utmpx.h \
 ])
 
+AC_CHECK_HEADERS([sys/pidfd.h])
+
 # There is a collision in old kernel-headers. The both files mount.h and fs.h
 # define MS_* macros. Fixed by kernel commit e462ec50cb5fad19f6003a3d8087f4a0945dd2b1.
 #
--- a/include/pidfd-utils.h
+++ b/include/pidfd-utils.h
@@ -4,6 +4,9 @@
 #if defined(__linux__)
 # include <sys/syscall.h>
 # if defined(SYS_pidfd_send_signal) && defined(SYS_pidfd_open)
+#  ifdef HAVE_SYS_PIDFD_H
+#   include <sys/pidfd.h>
+#  endif
 #  include <sys/types.h>
 
 #  ifndef HAVE_PIDFD_SEND_SIGNAL
